<Window x:Class="GestionUsuariosCETES.Views.alumno.AlumnoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionUsuariosCETES.Views.alumno"
        mc:Ignorable="d"
        Title="Registrar alumno" Height="450" Width="800">

	<StackPanel Margin="20">
		<TextBlock Text="Carnet:" Margin="0,5"/>
		<TextBox x:Name="txtCarnet" Height="25"/>

		<TextBlock Text="Nombre:" Margin="0,10,0,5"/>
		<TextBox x:Name="txtNombre" Height="25"/>

		<TextBlock Text="Apellido:" Margin="0,10,0,5"/>
		<TextBox x:Name="txtApellido" Height="25"/>

		<Button Content="Guardar Alumno" Height="35" Margin="0,20,0,0" Click="BtnGuardar_Click"/>
	</StackPanel>
</Window>
