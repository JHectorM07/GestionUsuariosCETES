<Window AllowsTransparency="True" Background="Transparent" Height="560" MouseLeftButtonDown="Window_MouseLeftButtonDown" ResizeMode="NoResize" Title="Inicio de Sesión - CETES" Width="430" WindowStartupLocation="CenterScreen" WindowStyle="None" x:Class="GestionUsuariosCETES.Views.auth.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <!-- Paleta de colores extraída del logo CETES -->
        <SolidColorBrush Color="#B88B4A" x:Key="CetesGold"/>
        <SolidColorBrush Color="#9E7438" x:Key="CetesGoldHover"/>
        <SolidColorBrush Color="#332A1E" x:Key="CetesTextDark"/>
        <SolidColorBrush Color="#7A6B56" x:Key="CetesTextMuted"/>
        <SolidColorBrush Color="#DFD6C7" x:Key="InputBorder"/>

        <!-- Estilo moderno para TextBox y PasswordBox -->
        <Style TargetType="Control" x:Key="ModernInputStyle">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CetesTextDark}"/>
            <Setter Property="Background" Value="#FDFCFA"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para el botón principal dorado -->
        <Style TargetType="Button" x:Key="GoldButtonStyle">
            <Setter Property="Background" Value="{StaticResource CetesGold}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="btnBorder">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="btnBorder" Value="{StaticResource CetesGoldHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal blanco con bordes redondeados y sombra suave -->
    <Border Background="White" BorderBrush="#EFECE6" BorderThickness="1" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.12" ShadowDepth="2"/>
        </Border.Effect>

        <Grid Margin="35,20,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Botón discreto para cerrar en la esquina superior derecha -->
            <Button Background="Transparent" BorderThickness="0" Click="BtnCerrar_Click" Content="✕" Cursor="Hand" FontSize="15" Foreground="{StaticResource CetesTextMuted}" Grid.Row="0" HorizontalAlignment="Right" Padding="5"/>

            <!-- Logo centrado arriba del formulario -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,22">
                <Image Height="135" HorizontalAlignment="Center" Source="/assets/logoCETES.jpg" Stretch="Uniform"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource CetesTextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" Text="Sistema de Gestión Administrativa"/>
            </StackPanel>

            <!-- Formulario de Login -->
            <StackPanel Grid.Row="2" VerticalAlignment="Top">

                <!-- Campo Usuario -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CetesTextDark}" Margin="0,0,0,6" Text="Nombre de usuario"/>
                <TextBox Margin="0,0,0,16" Style="{StaticResource ModernInputStyle}" x:Name="TxtUsuario">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Campo Contraseña -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CetesTextDark}" Margin="0,0,0,6" Text="Contraseña"/>
                <PasswordBox Margin="0,0,0,10" Style="{StaticResource ModernInputStyle}" x:Name="TxtPassword">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Mensaje de error (oculto por defecto) -->
                <TextBlock FontSize="12.5" Foreground="#DC2626" Margin="0,2,0,12" Text="Usuario o contraseña incorrectos." Visibility="Collapsed" x:Name="LblError"/>

                <!-- Botón Ingresar -->
                <Button Click="BtnIngresar_Click" Content="Iniciar Sesión" IsDefault="True" Margin="0,12,0,0" Style="{StaticResource GoldButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>