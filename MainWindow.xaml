<Window x:Class="GestionUsuariosCETES.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CETES - Sistema de Gestión Administrativa"
        Height="740" Width="1260" MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F8F7F4">

    <Window.Resources>
        <!-- Paleta de colores CETES -->
        <SolidColorBrush x:Key="CetesGold" Color="#B88B4A"/>
        <SolidColorBrush x:Key="CetesGoldLight" Color="#F7F1E8"/>
        <SolidColorBrush x:Key="CetesTextDark" Color="#332A1E"/>
        <SolidColorBrush x:Key="CetesTextMuted" Color="#7A6B56"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#EAE5DC"/>

        <!-- Estilo para botones del menú lateral -->
        <Style x:Key="SidebarMenuStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource CetesTextDark}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="MenuBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="{StaticResource CetesGoldLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="{StaticResource CetesGold}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú Lateral Fijo -->
            <ColumnDefinition Width="250"/>
            <!-- Área Dinámica de Vistas -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL LATERAL IZQUIERDO -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="18,22">
            <DockPanel LastChildFill="False">

                <!-- Cabecera con Logo CETES -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                    <Image Source="/assets/logoCETES.jpg" Height="85" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="10,18,10,0"/>
                </StackPanel>

                <!-- Opciones de Navegación -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MENÚ PRINCIPAL" FontSize="11" FontWeight="Bold" 
                               Foreground="{StaticResource CetesTextMuted}" Margin="12,0,0,8"/>

                    <RadioButton x:Name="NavInicio" Content="Inicio / Resumen" Tag="🏠"
                                 GroupName="MainNav" IsChecked="True" Style="{StaticResource SidebarMenuStyle}"/>

                    <RadioButton x:Name="NavAlumnos" Content="Alumnos" Tag="👩‍🎓"
                                 GroupName="MainNav" Style="{StaticResource SidebarMenuStyle}"/>

                    <RadioButton x:Name="NavCursos" Content="Cursos y Horarios" Tag="📚"
                                 GroupName="MainNav" Style="{StaticResource SidebarMenuStyle}"/>

                    <RadioButton x:Name="NavInscripciones" Content="Inscripciones" Tag="📝"
                                 GroupName="MainNav" Style="{StaticResource SidebarMenuStyle}"/>

                    <RadioButton x:Name="NavPagos" Content="Control de Pagos" Tag="💳"
                                 GroupName="MainNav" Style="{StaticResource SidebarMenuStyle}"/>
                </StackPanel>

                <!-- Pie del Menú: Usuario activo y Cerrar Sesión -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#FAF8F5" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="TxtUsuarioActivo" Text="Administrador" FontWeight="SemiBold"
                                       FontSize="13" Foreground="{StaticResource CetesTextDark}"/>
                            <TextBlock Text="Sesión activa" FontSize="11.5" Foreground="{StaticResource CetesTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnCerrarSesion" Content="Cerrar Sesión" Height="40" Cursor="Hand"
                            Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTENEDOR CENTRAL DONDE CARGAN LOS USERCONTROLS -->
        <ContentControl x:Name="ContenedorVistas" Grid.Column="1" Margin="28,24"/>
    </Grid>
</Window>